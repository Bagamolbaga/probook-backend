PORT=4000
DATABASE_URL=""
FRONTEND_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000"

AUTH_SECRET=""
AUTH_ACCESS_TOKEN_TTL_SECONDS=36000
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# Must match GOOGLE_CLIENT_ID in front-main. The secret is used only by NextAuth.
GOOGLE_CLIENT_ID=""

# Employee invitation delivery. Use a dedicated Gmail account with 2FA and an App Password.
EMAIL_PROVIDER="gmail"
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
EMAIL_FROM="ProBook <probook.notifications@gmail.com>"
INVITATION_TTL_HOURS=168

# Required only when intentionally running `pnpm reset:test-data`.
ALLOW_DATABASE_RESET=false
